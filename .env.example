# DevCollab local infrastructure
TZ=Asia/Shanghai

# PostgreSQL container
POSTGRES_DB=devcollab
POSTGRES_USER=devcollab
POSTGRES_PASSWORD=devcollab
POSTGRES_HOST_PORT=5432

# Redis container
REDIS_HOST_PORT=6379

# Kafka container
KAFKA_HOST_PORT=9092

# Elasticsearch container
ELASTICSEARCH_HOST_PORT=9200
ELASTICSEARCH_TRANSPORT_HOST_PORT=9300
ELASTICSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# Knowledge Core datasource
DEVCOLLAB_DB_URL=jdbc:postgresql://localhost:5432/devcollab
DEVCOLLAB_DB_USERNAME=devcollab
DEVCOLLAB_DB_PASSWORD=devcollab

# Knowledge Core security
DEVCOLLAB_JWT_ISSUER=devcollab-knowledge-core
DEVCOLLAB_JWT_AUDIENCE=devcollab-web
DEVCOLLAB_JWT_SECRET=devcollab-local-development-secret-change-me
DEVCOLLAB_ACCESS_TOKEN_TTL=PT30M
DEVCOLLAB_REFRESH_TOKEN_TTL=P7D
DEVCOLLAB_REFRESH_COOKIE_NAME=dc_refresh
DEVCOLLAB_CSRF_COOKIE_NAME=dc_csrf
DEVCOLLAB_CSRF_HEADER_NAME=X-CSRF-Token
DEVCOLLAB_WEB_ORIGIN=http://localhost:5173
DEVCOLLAB_COOKIE_SECURE=false

# Knowledge Core search
DEVCOLLAB_SEARCH_ENGINE=postgres
DEVCOLLAB_ELASTICSEARCH_ENABLED=false
DEVCOLLAB_ELASTICSEARCH_URL=http://localhost:9200
DEVCOLLAB_ELASTICSEARCH_INDEX=devcollab-search
